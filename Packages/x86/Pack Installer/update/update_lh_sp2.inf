[Base.System32.Files]
    bcryptprimitives.dll,base\bcryptprimitives.dll
    certupdate.exe,base\certupdate.exe
    combase.dll,base\combase.dll
    cryptbase.dll,base\cryptbase.dll
    shcore.dll,base\shcore.dll
	
[Wrappers.System32.Files]
    ; advapi32.dll,wrappers\advapi32_wrapper.dll
    ; browseui.dll,wrappers\browseui.dll
    ; cfgmgr32.dll,wrappers\cfgmgr32.dll
    ; comdlg32.dll,wrappers\comdlg32.dll
    ; gdi32.dll,wrappers\gdi32.dll
    ; msvcrt.dll,base\msvcrt.dll
