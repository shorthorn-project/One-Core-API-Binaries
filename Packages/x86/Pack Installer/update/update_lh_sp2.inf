[Version]
    LanguageType           = %LANGTYPEVALUE%
    MaxNtBuildToUpdate        = 6003
    MaxNtMajorVersionToUpdate = 6
    MaxNtMinorVersionToUpdate = 0
    MaxNtServicePackVersion   = 1024
    MinNtServicePackVersion   = 0
    NtBuildToUpdate           = 6002
    NtMajorVersionToUpdate    = 6
    NtMinorVersionToUpdate    = 0
    Signature                 = "$Windows NT$"
    
[Configuration]
    noPNPfiles=1
    InstallationType        = Hotfix
    InstallLogFileName      = %SP_SHORT_TITLE%.log
    UnInstallLogFileName    = %SP_SHORT_TITLE%Uninst.log
    UnInstallDirName        = $NtUninstall%SP_SHORT_TITLE%$
    EventLogKeyName         = NtServicePack
    EventLogDllName         = spmsg.dll    
    
[Strings]
    SERVICE_PACK_NUMBER     = 3
    HelpLink = "http://shorthornproject.com"
    URLInfoAbout = "http://shorthornproject.com"
    APPC_VERSION            = "4.0.10"    
    UPDATE                  = "Update"
    HOTFIX                  = "Hotfix"
    SECURITY_UPDATE         = "Security Update"
    LangTypeValue           = 0x0
    ServicePackSourceFiles  = "One-Core-API AppCompat Source Files"
    SP_SHORT_TITLE          = "OCAB"
    SP_TITLE                = "One-Core-API Pack"
    PARENT_DISPLAY_NAME     = "One-Core-API"
    LOC_UPDATE="Update"
    LOC_CRITICALUPDATE="Critical Update"
    LOC_HOTFIX="Hotfix"
    LOC_SECURITY_UPDATE="Security Update"    
    
[Product.Add.Reg]
    HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Setup", "LogLevel", 0x10001, 0
    HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%SP_SHORT_TITLE%","ParentKeyName",0x00000000,"OperatingSystem"
    HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%SP_SHORT_TITLE%","ParentDisplayName",0x00000000,"%PARENT_DISPLAY_NAME%"
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Installed",0x10001,1
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Comments",0,%SP_TITLE%
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Backup Dir",0,""
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Fix Description",0,%SP_TITLE%
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Installed By",0,""
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Installed On",0,""
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Service Pack",0x10001,%SERVICE_PACK_NUMBER%
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%,"Valid",0x10001,1
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%\File 1\,"Flags",0,""
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%\File 1\,"New File",0,""
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%\File 1\,"New Link Date",0,""
    HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Hotfix\%SP_SHORT_TITLE%\File 1\,"Old Link Date",0,""
    HKLM,SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%SP_SHORT_TITLE%,"DisplayVersion",0x00000000,%APPC_VERSION%
    HKLM,SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\%SP_SHORT_TITLE%,"ReleaseType",0,%HOTFIX%
	
	;Adding some keys to System Variables to improve compatibility
	HKLM,"SYSTEM\CurrentControlSet\Control\Session Manager\Environment","MOZ_DISABLE_CONTENT_SANDBOX",0x0,"1"

    HKCR,"CLSID\{513D916F-2A8E-4F51-AEAB-0CBC76FB1AF8}\InprocServer32",,0x0,"SlayerXP.dll"
    HKLM,"SOFTWARE\Classes\CLSID\{513D916F-2A8E-4F51-AEAB-0CBC76FB1AF8}\InprocServer32",,0x0,"SlayerXP.dll"

[ProductInstall.ReplaceFilesIfExist]
    ;CopyFiles=System32.files
    
[ProductInstall.DontDelayUntilReboot]
    CopyFiles = CopyAlways.System32.APISET.files
    CopyFiles = Drivers.CoreDriverFiles 	
    CopyFiles = MustReplace.System32.files
    CopyFiles = Wrappers.System32.Files

[ProductInstall.CopyFilesAlways]
    CopyFiles = Base.System32.Files
    CopyFiles = CopyAlways.System32.APISET.files
    CopyFiles = CopyAlways.System32.files
    CopyFiles = CopyAlways.AppPatch.System32.Files		

[ProductInstall.GlobalRegistryChanges.Install]
    AddReg=Product.Add.Reg

[ProductInstall.GlobalRegistryChanges.ReInstall]
    AddReg=Product.Add.Reg

[DestinationDirs]
    CopyFiles= Base.System32.Files
    CopyAlways.AppPatch.System32.Files=11  ; %windir%\system32 (don't delay until reboot)	
    CopyAlways.System32.APISET.files=11  ; %windir%\system32 (don't delay until reboot)
    CopyAlways.System32.files=11  ; %windir%\system32 (don't delay until reboot)
    Drivers.CoreDriverFiles = 12 ; %windir%\system32\drivers
	Wrappers.System32.Files=11  ; %windir%\system32 (don't delay until reboot)
    MustReplace.System32.Files=11  ; %windir%\system32 (don't delay until reboot)
	
[CopyAlways.AppPatch.System32.Files]
    slayeroca.dll,appcompat\slayeroca.dll
	
[CopyAlways.System32.Files]
    advapiex.dll,extensions\advapiex.dll
    cfgmgrex.dll,extensions\cfgmgrex.dll
    dwmapiext.dll,base\dwmapi.dll
    dwritecore.dll,d3d\dwritecore.dll ;move to d3d copy
    kernelex.dll,extensions\kernelex.dll
    kernelbase.dll,extensions\kernelex.dll
    netapiex.dll,extensions\netapiex.dll
    ntext.dll,extensions\ntext.dll
    oleex.dll,extensions\oleex.dll
