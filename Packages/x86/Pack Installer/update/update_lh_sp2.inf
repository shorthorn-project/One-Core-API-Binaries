    dwrite.dll,d3d\dwrite.dll	
    kernel32.dll,osfiles\vista\COMMON\lhkernel32.dll	
	netapi32.dll,osfiles\vista\COMMON\lhnetapi32.dll
	ntdll.dll,osfiles\vista\COMMON\lhntdll.dll
	ole32.dll,osfiles\vista\COMMON\lhole32.dll
	powrprof.dll,osfiles\vista\COMMON\lhpowrprof.dll
	shell32.dll,osfiles\vista\COMMON\lhshell32.dll
	user32.dll,osfiles\vista\COMMON\lhuser32.dll	
